# Personal registry token for the private CodedVisuals shadcn registry.
# Only needed to install visuals beyond the 5 free ones in this repo.
#
# Buy a license at https://codedvisuals.com/pricing, then issue a token from
# Settings > Registry token. It is shown once, so copy it right away.
#
# Copy this file to .env.local (gitignored) and paste your token below.
CODEDVISUALS_TOKEN=
